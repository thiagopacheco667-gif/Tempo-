<?xml version="1.0" encoding="utf-8"?>
<!-- Atmosfera: nublado — azul acinzentado e luz difusa -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#FF2E3E5C" android:centerColor="#FF1F2C47" android:endColor="#FF121B2F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.8" android:centerY="0.0"
                android:gradientRadius="100%" android:startColor="#3DDCE6F5" android:centerColor="#12DCE6F5" android:endColor="#00DCE6F5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.05" android:centerY="1.0"
                android:gradientRadius="80%" android:startColor="#2A6C7FA8" android:centerColor="#0C6C7FA8" android:endColor="#006C7FA8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#12FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#14000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke android:width="1dp" android:color="#1CFFFFFF" />
        </shape>
    </item>
</layer-list>

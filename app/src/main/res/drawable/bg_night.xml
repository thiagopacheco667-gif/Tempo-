<?xml version="1.0" encoding="utf-8"?>
<!-- Atmosfera: noite — quase preto com brilho lunar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#FF0B1433" android:centerColor="#FF060C21" android:endColor="#FF02040D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.86" android:centerY="0.04"
                android:gradientRadius="85%" android:startColor="#3A8FB2FF" android:centerColor="#0E8FB2FF" android:endColor="#008FB2FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.0" android:centerY="1.0"
                android:gradientRadius="80%" android:startColor="#2A5B45B8" android:centerColor="#0A5B45B8" android:endColor="#005B45B8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#12FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#14000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke android:width="1dp" android:color="#1CFFFFFF" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Atmosfera: chuva — azul profundo e frio -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#FF11284D" android:centerColor="#FF0A1A37" android:endColor="#FF050E21" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.85" android:centerY="0.0"
                android:gradientRadius="95%" android:startColor="#504A8EE8" android:centerColor="#164A8EE8" android:endColor="#004A8EE8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.0" android:centerY="1.0"
                android:gradientRadius="80%" android:startColor="#2E2FA3C7" android:centerColor="#0C2FA3C7" android:endColor="#002FA3C7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#12FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#14000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke android:width="1dp" android:color="#1CFFFFFF" />
        </shape>
    </item>
</layer-list>

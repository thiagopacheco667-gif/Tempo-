<?xml version="1.0" encoding="utf-8"?>
<!-- Atmosfera: pôr do sol — azul que se dissolve em laranja -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#FF142A60" android:centerColor="#FF2B2C66" android:endColor="#FF4E3159" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.95" android:centerY="1.0"
                android:gradientRadius="115%" android:startColor="#D9FF8A4C" android:centerColor="#46FF6A3D" android:endColor="#00FF6A3D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.0" android:centerY="0.0"
                android:gradientRadius="85%" android:startColor="#384A7BE0" android:centerColor="#0E4A7BE0" android:endColor="#004A7BE0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#12FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#14000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke android:width="1dp" android:color="#1CFFFFFF" />
        </shape>
    </item>
</layer-list>

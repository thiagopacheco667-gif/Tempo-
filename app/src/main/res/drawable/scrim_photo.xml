<?xml version="1.0" encoding="utf-8"?>
<!--
  Véu sobre as fotografias: azul-marinho translúcido (mantém a identidade), mais denso no topo
  (cabeçalho), à esquerda (temperatura) e na base (indicadores e previsão), onde há texto.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <solid android:color="#66050B1E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:startColor="#73050B1E" android:centerColor="#1A050B1E" android:endColor="#A6050B1E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="0" android:startColor="#66050B1E" android:centerColor="#00050B1E" android:endColor="#33050B1E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Expandida: clima atual, alerta, indicadores e 5 dias -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:clipToOutline="true"
    android:background="@drawable/bg_night">

    <!-- Duas camadas de atmosfera: a troca entre elas gera um crossfade suave -->
    <ImageView android:id="@+id/bg_a" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/bg_night" />
    <ImageView android:id="@+id/bg_b" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="invisible" />
    <!-- Detalhe atmosférico estático (estrelas, chuva, névoa, luz) -->
    <ImageView android:id="@+id/deco" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="14dp"
        android:paddingTop="10dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="5dp"
                    android:alpha="0.9" android:src="@drawable/gl_pin" android:importantForAccessibility="no" />
                <TextView android:id="@+id/city" style="@style/WText.City" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/app_name" />
                <TextView android:id="@+id/region" style="@style/WText.Region" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/alert_chip" android:layout_width="wrap_content" android:layout_height="22dp"
                    android:layout_marginStart="4dp" android:layout_marginEnd="8dp" android:background="@drawable/chip"
                    android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp"
                    android:paddingEnd="8dp" android:visibility="gone">
                    <ImageView android:id="@+id/alert_icon" android:layout_width="11dp" android:layout_height="11dp"
                        android:src="@drawable/gl_alert" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/alert_text" style="@style/WText.Chip" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="1dp" />
                </LinearLayout>
            <ImageView android:id="@+id/status_dot" android:layout_width="5dp" android:layout_height="5dp"
                android:layout_marginEnd="5dp" android:src="@drawable/status_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/updated" style="@style/WText.Caption" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="8dp" />
            <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:animateLayoutChanges="true">
                <ImageView android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/glass_button" android:padding="8dp" android:src="@drawable/gl_refresh"
                    android:alpha="0.9" android:contentDescription="@string/cd_refresh" />
                <ProgressBar android:id="@+id/loading" style="@style/WLoader" android:layout_width="16dp"
                    android:layout_height="16dp" android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/temp_box" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:animateLayoutChanges="true" android:layout_marginStart="-3dp">
                <TextView android:id="@+id/temp_a" style="@style/WText.Temp" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="62sp" />
                <TextView android:id="@+id/temp_b" style="@style/WText.Temp" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="62sp" android:visibility="invisible" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/condition" style="@style/WText.Condition" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="15sp" />
                <TextView android:id="@+id/hilo" style="@style/WText.HiLo" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/feels" style="@style/WText.Detail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="3dp" />
            </LinearLayout>
            <FrameLayout android:id="@+id/icon_box" android:layout_width="64dp" android:layout_height="64dp"
                android:animateLayoutChanges="true" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/icon_a" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:contentDescription="@string/cd_condition_icon" android:src="@drawable/wx_cloudy" />
                <ImageView android:id="@+id/icon_b" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:contentDescription="@string/cd_condition_icon" android:visibility="invisible" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/alert_banner" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:background="@drawable/chip_banner" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
            <ImageView android:id="@+id/banner_icon" android:layout_width="13dp" android:layout_height="13dp"
                android:layout_marginEnd="7dp" android:src="@drawable/gl_alert" android:importantForAccessibility="no" />
            <TextView android:id="@+id/banner_text" style="@style/WText.Chip" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/metrics" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:background="@drawable/glass_soft" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
                <LinearLayout android:id="@+id/m0" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical"
                    android:contentDescription="@string/cd_rain">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/m0_icon" android:layout_width="13dp" android:layout_height="13dp"
                            android:layout_marginEnd="4dp" android:src="@drawable/gl_rain" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/m0_value" style="@style/WText.MetricValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:id="@+id/m0_label" style="@style/WText.MetricLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
<ImageView android:layout_width="1dp" android:layout_height="22dp" android:layout_gravity="center_vertical"
                    android:src="@drawable/hairline_v" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/m1" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical"
                    android:contentDescription="@string/cd_humidity">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/m1_icon" android:layout_width="13dp" android:layout_height="13dp"
                            android:layout_marginEnd="4dp" android:src="@drawable/gl_humidity" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/m1_value" style="@style/WText.MetricValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:id="@+id/m1_label" style="@style/WText.MetricLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
<ImageView android:layout_width="1dp" android:layout_height="22dp" android:layout_gravity="center_vertical"
                    android:src="@drawable/hairline_v" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/m2" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical"
                    android:contentDescription="@string/cd_wind">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/m2_icon" android:layout_width="13dp" android:layout_height="13dp"
                            android:layout_marginEnd="4dp" android:src="@drawable/gl_wind" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/m2_value" style="@style/WText.MetricValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:id="@+id/m2_label" style="@style/WText.MetricLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
<ImageView android:layout_width="1dp" android:layout_height="22dp" android:layout_gravity="center_vertical"
                    android:src="@drawable/hairline_v" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/m3" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical"
                    android:contentDescription="@string/cd_uv">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/m3_icon" android:layout_width="13dp" android:layout_height="13dp"
                            android:layout_marginEnd="4dp" android:src="@drawable/gl_uv" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/m3_value" style="@style/WText.MetricValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:id="@+id/m3_label" style="@style/WText.MetricLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/forecast_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="4dp" android:paddingEnd="4dp" android:visibility="gone">
            <TextView style="@style/WText.Section" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/next_days" />
            <ImageView android:id="@+id/aqi_dot" android:layout_width="6dp" android:layout_height="6dp"
                android:layout_marginEnd="5dp" android:src="@drawable/status_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/aqi_text" style="@style/WText.Caption" android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:id="@+id/forecast" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/glass_soft" android:orientation="horizontal"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <LinearLayout android:id="@+id/d0" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/d0_name" style="@style/WText.Day" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ImageView android:id="@+id/d0_icon" android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/d0_max" style="@style/WText.DayMax" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/d0_min" style="@style/WText.DayMin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="1dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/d1_name" style="@style/WText.Day" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ImageView android:id="@+id/d1_icon" android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/d1_max" style="@style/WText.DayMax" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/d1_min" style="@style/WText.DayMin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="1dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/d2_name" style="@style/WText.Day" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ImageView android:id="@+id/d2_icon" android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/d2_max" style="@style/WText.DayMax" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/d2_min" style="@style/WText.DayMin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="1dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/d3_name" style="@style/WText.Day" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ImageView android:id="@+id/d3_icon" android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/d3_max" style="@style/WText.DayMax" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/d3_min" style="@style/WText.DayMin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="1dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/d4_name" style="@style/WText.Day" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ImageView android:id="@+id/d4_icon" android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/d4_max" style="@style/WText.DayMax" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/d4_min" style="@style/WText.DayMin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/hint" style="@style/WText.Detail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
            android:maxLines="2" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
